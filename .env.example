# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Your Telegram User ID (from @userinfobot)
ADMIN_USER_ID=987654321

# Emergency password to link secondary Telegram accounts (2-min silent window)
EMERGENCY_PASSWORD=$12Abdurahmon1

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./data/finance.db

# Environment: development / production
ENVIRONMENT=development

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Web Server & Telegram Mini App URL (e.g. https://your-domain.com or ngrok URL for local dev)
WEBAPP_URL=
WEB_PORT=8080

# Turso Cloud Sync (Hybrid storage for Render deployment)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_SYNC_INTERVAL_SECONDS=60
